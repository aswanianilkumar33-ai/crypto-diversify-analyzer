{
  "name": "CryptoDiversify v3",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"],
  "background": "#ffffff",
  "foreground": "#0b0b0b",
  "tableAccent": "#0d3d7a",
  "good": "#008300",
  "neutral": "#eda100",
  "bad": "#e34948",
  "minimum": "#eaf2fc",
  "center": "#7fb0ea",
  "maximum": "#0d3d7a",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0b0b0b" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0b0b0b" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52514e" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#0d3d7a" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#e4e8ee" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#e4e8ee" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#e1e5eb" } }, "radius": 10 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }],
        "title": [{ "fontSize": 12, "fontColor": { "solid": { "color": "#0b0b0b" } } }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#eceef1" } } }]
      }
    }
  }
}
